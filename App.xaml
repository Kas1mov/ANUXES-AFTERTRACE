<Application x:Class="ANUXES.Aftertrace.App"
             
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="BgColor">#111013</Color>
        <Color x:Key="PanelColor">#17141C</Color>
        <Color x:Key="PanelRaisedColor">#1D1924</Color>
        <Color x:Key="AccentColor">#A855F7</Color>
        <Color x:Key="AccentBrightColor">#D8B4FE</Color>
        <Color x:Key="TextColor">#F3EEFF</Color>
        <Color x:Key="MutedColor">#8D91B2</Color>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

        <Style x:Key="GlowButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#B77BFF" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7834D8" Offset="0" />
                        <GradientStop Color="#432080" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#A855F7" BlurRadius="19" ShadowDepth="0" Opacity="0.55" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GlowButtonScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowButtonScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="GlowButtonScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="GlowButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E3C5FF" />
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C084FC" BlurRadius="27" ShadowDepth="0" Opacity="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#D8CCF2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1A1621" />
            <Setter Property="BorderBrush" Value="#3A2B4B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuietBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="QuietButtonScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="QuietButtonScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="QuietButtonScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="QuietButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="QuietButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="QuietBorder" Property="BorderBrush" Value="#A855F7" />
                                <Setter TargetName="QuietBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#9333EA" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="QuietBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#A7A7C4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SideBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="SidebarButtonScale" />
                            </Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SidebarButtonScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.13" />
                                            <DoubleAnimation Storyboard.TargetName="SidebarButtonScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.13" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SidebarButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="SidebarButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="SideBorder" Property="Background" Value="#21172B" />
                                <Setter Property="Foreground" Value="#F0DFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SideBorder" Property="Background" Value="#30203F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Compact, fully custom title-bar controls -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AFA4C4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="WindowControlScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="WindowControlScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="WindowControlScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="WindowControlScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="WindowControlScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Chrome" Property="Background" Value="#241A30" />
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="13" ShadowDepth="0" Opacity="0.7" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#E9D5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox: no native white surface or blue focus border. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#100E14" />
            <Setter Property="Foreground" Value="#DCCBFA" />
            <Setter Property="BorderBrush" Value="#3A2B4B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#D8B4FE" />
            <Setter Property="SelectionBrush" Value="#7136A8" />
            <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#A855F7" />
                                <Setter TargetName="TextBoxBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#9333EA" BlurRadius="13" ShadowDepth="0" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#100E16" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar used by ScrollViewer and wrapped TextBox controls. -->
        <Style x:Key="AftertraceScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="3" />
            <Setter Property="MinWidth" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbFace" Margin="2" CornerRadius="10"
                                Background="#49305F" BorderBrush="#76509A" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbFace" Property="Background" Value="#8B45C8" />
                                <Setter TargetName="ThumbFace" Property="BorderBrush" Value="#D8B4FE" />
                                <Setter TargetName="ThumbFace" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="17" ShadowDepth="0" Opacity="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbFace" Property="Background" Value="#A855F7" />
                                <Setter TargetName="ThumbFace" Property="BorderBrush" Value="#E9D5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AftertraceScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="#111013" />
            <Setter Property="Foreground" Value="#A855F7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot" Background="#111013" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AftertraceScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AftertraceScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AftertraceScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="11" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ScrollRoot" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Any future ordinary buttons also inherit the dark ANUXES treatment. -->
        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}" />

        <!-- Change Tracking controls: dark ANUXES surfaces with purple neon selection states. -->
        <Style x:Key="ChangeTrackingListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChangeItemChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" Padding="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChangeItemChrome" Property="Background" Value="#21172B" />
                                <Setter TargetName="ChangeItemChrome" Property="BorderBrush" Value="#70458D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChangeItemChrome" Property="Background" Value="#28163D" />
                                <Setter TargetName="ChangeItemChrome" Property="BorderBrush" Value="#B77BFF" />
                                <Setter TargetName="ChangeItemChrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="16" ShadowDepth="0" Opacity="0.72" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ChangeItemChrome" Property="BorderBrush" Value="#8B5CF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChangeTrackingListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#111015" />
            <Setter Property="Foreground" Value="#E8DEFA" />
            <Setter Property="BorderBrush" Value="#493356" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChangeTrackingListBoxItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="ChangeTrackingFilterChip" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#1A1621" />
            <Setter Property="Foreground" Value="#AFA4C4" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FilterChipChrome" Background="{TemplateBinding Background}"
                                BorderBrush="#30243A" BorderThickness="1" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterChipChrome" Property="Background" Value="#21172B" />
                                <Setter TargetName="FilterChipChrome" Property="BorderBrush" Value="#8B5CF6" />
                                <Setter TargetName="FilterChipChrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0" Opacity="0.42" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F3EEFF" />
                                <Setter TargetName="FilterChipChrome" Property="Background" Value="#34204F" />
                                <Setter TargetName="FilterChipChrome" Property="BorderBrush" Value="#B77BFF" />
                                <Setter TargetName="FilterChipChrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.62" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChangeTrackingFilterBar" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#AFA4C4" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChangeTrackingFilterChip}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>



    </Application.Resources>
</Application>
    
